# Firebase client configuration.
# Copy this file to `.env` (never commit `.env`) and fill in the values from
# the Firebase console: Project settings -> General -> Your apps -> Web app.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Gemini API for AI features
GEMINI_API_KEY=

# Firebase Admin credentials, used by the AI routes (/api/ai/decompose,
# /api/ai/summarize) to verify the caller's ID token server-side.
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key, then paste the JSON as ONE line (env files cannot hold a
# multi-line value). Without it those routes answer 503 "AI service not
# configured" instead of calling Gemini.
FIREBASE_SERVICE_ACCOUNT=
